# OUTIS RADAR — environment configuration
#
# Copy to `.env` at the repo root for local development:  cp .env.example .env
# `.env` is git-ignored. In production set these in your host's environment
# settings (Vercel → Project → Settings → Environment Variables, GitHub →
# Settings → Secrets and variables → Actions). Never commit real values.

# ── Database ────────────────────────────────────────────────────────────────
# Local:    postgresql://<user>@localhost:5432/outis_radar
# Supabase: DATABASE_URL = the "Transaction pooler" URL with ?pgbouncer=true&connection_limit=1
#           DIRECT_URL   = the "Session pooler"/direct URL (used by migrations)
DATABASE_URL="postgresql://USER@localhost:5432/outis_radar"
DIRECT_URL="postgresql://USER@localhost:5432/outis_radar"
# Only used by the persistence tests. Must be a throwaway database — tests wipe it.
DATABASE_URL_TEST="postgresql://USER@localhost:5432/outis_radar_test"

# ── Scanning ────────────────────────────────────────────────────────────────
# Comma-separated chain ids from packages/shared/src/chains.ts.
# Empty = the registry defaults (discoveryEnabledByDefault in chains.ts).
SCAN_CHAINS=""
# GeckoTerminal new_pools pages per PRIORITY-1 chain per scan (20 pools/page,
# max 10). Other chains get 1 page. GeckoTerminal allows ~6 calls/min in
# practice, so every page costs ~10s of scan time.
SCAN_NEW_POOL_PAGES=2
# Pairs below this USD liquidity are not stored, unless liquidity is unknown
# (pump.fun bonding curves report none). 0 stores everything.
SCAN_INGEST_MIN_LIQUIDITY_USD=500
# Pairs older than this stop being refreshed.
SCAN_REFRESH_MAX_AGE_HOURS=72
# Upper bound on pairs refreshed per chain per scan (DEX Screener, 30 per call).
SCAN_REFRESH_LIMIT=90
# Hard wall-clock budget for one scan; the scan checkpoints and exits.
SCAN_MAX_DURATION_MS=420000
# Snapshots older than this are pruned (keeps a free-tier DB small).
SNAPSHOT_RETENTION_DAYS=14

# ── Risk checks (GoPlus, free, ~8 calls/min, one token per call) ───────────
# Tokens sent for contract/holder checks per risk-job run.
RISK_CHECKS_PER_RUN=30
# Re-check a token GoPlus has answered for after this many hours.
RISK_RECHECK_HOURS=12
RISK_MAX_DURATION_MS=420000

# ── Wallet tracking ─────────────────────────────────────────────────────────
# Keyless sources cover Solana, Arbitrum, Optimism, Avalanche, Ethereum, Unichain
# and Ink. Base, BSC, Robinhood, Polygon and the rest need RPC_URL_<CHAIN> below
# (a free Alchemy/QuickNode key is enough).
WALLET_SYNC_MAX_WALLETS=25
# First sync of a newly added wallet looks back this far.
WALLET_BACKFILL_HOURS=72
# Transactions fetched one by one per wallet per run (Solana; ETH legs of buys).
WALLET_MAX_TX_FETCHES=40

# ── Paper trading (no real money, ever) ─────────────────────────────────────
PAPER_START_BALANCE_USD=10000
PAPER_DEFAULT_SIZE_USD=100
# Swap fee per side (100 = 1%; pump.fun-like, conservative for most DEXes).
PAPER_FEE_BPS=100
# Extra slippage per side on top of modelled price impact.
PAPER_SLIPPAGE_BPS=50

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Enables write endpoints (scoring config). Generate one: openssl rand -hex 24
# Leave empty to keep the API read-only.
ADMIN_TOKEN=
# Origins allowed by CORS, comma-separated.
WEB_ORIGIN="http://localhost:3000"
# Required when deployed: every endpoint except /health wants this in the
# x-api-token header. Set the SAME value on the web project. openssl rand -hex 24
API_READ_TOKEN=

# ── Web ─────────────────────────────────────────────────────────────────────
# 1 = the dashboard can add/remove wallets, watchlist items and paper trades (it
# calls the API with ADMIN_TOKEN, server-side; the token never reaches a browser).
DASHBOARD_WRITES=0
# Sign-in for the dashboard. Required when deployed — without it a Vercel
# deployment shows only a "set DASHBOARD_PASSWORD" page. Empty = open (local only).
DASHBOARD_PASSWORD=
# Optional: signs session cookies. Unset = derived from the password, so
# changing the password signs everyone out.
SESSION_SECRET=
# Where the dashboard's server components reach the API.
API_URL="http://localhost:4000"

# ── RPC endpoints (optional until risk/holder checks land, Milestone 3+) ────
# Leave empty rather than pasting a URL you have not checked. Keys inside a URL
# are secrets — set them in the host's env settings, not in this file.
RPC_URL_SOLANA=
RPC_URL_BASE=
RPC_URL_ETHEREUM=
RPC_URL_BSC=
RPC_URL_ARBITRUM=
RPC_URL_ROBINHOOD=
RPC_URL_POLYGON=

# ── Telegram alerts ─────────────────────────────────────────────────────────
# Create a bot with @BotFather and put its token here (never in chat or git).
# Use a NEW bot for this — not one another app already polls (two pollers
# fight over updates and both break).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Unknown users get
# their own id back and nothing else. Send /start to the bot to learn yours.
TELEGRAM_ALLOWED_USER_IDS=
# Public dashboard URL for links in alerts (leave empty for local-only).
DASHBOARD_URL=
# How often alerts are generated and sent by the local bot (seconds, min 20).
ALERT_INTERVAL_SECONDS=60
# Deployed: Telegram proves each webhook call with this. 24+ chars [A-Za-z0-9_-].
TELEGRAM_WEBHOOK_SECRET=
# Time budget for one scheduled `bot --once` delivery pass (seconds).
ALERT_ONCE_SECONDS=120
# Subscribers get one "scans have stopped" warning after this many minutes.
STALE_SCAN_MINUTES=60
